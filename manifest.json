{
  "manifest_version": 3,
  "name": "Serum",
  "version": "1.0.0",
  "description": "YouTube shows only what you want: videos and Shorts are kept by your keywords, the rest is hidden or skipped.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": {
    "default_title": "Serum",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["lib.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
